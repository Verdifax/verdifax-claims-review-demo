{
  "rule_set_sha256": "a2afb580a203ccbd084645cfbbce532dd7eaf1d2dbeaa49fd008f66a91f98ae7",
  "note": "Every command, flag, file and sealed field of the claims review demo, held equal across python, node, go and r. scripts/check-public-claims.py (rule R131) fails when a program lacks one or a language's copy differs.",
  "commands": {
    "setup": {
      "flags": [],
      "env": [
        "VERDIFAX_OWNER_KEY"
      ],
      "writes": [
        "demo-keys.json",
        "approver-key.json",
        "approver.txt",
        "account-history.json"
      ]
    },
    "review": {
      "flags": [
        "--model",
        "--answers"
      ],
      "env": [
        "ANTHROPIC_API_KEY"
      ],
      "writes": [
        "records/<job_id>/steps/<step>.json (the sealed records, the folder verdifax-verify --job reads)",
        "records/<job_id>/steps/<step>.deleted.json (a deleted step's tombstone: the run.deleted entry from the account feed, which verdifax-verify --job reads in the step's place)",
        "records/<job_id>/payloads/<step>.json",
        "records/<job_id>/answers/<step>.txt (the model's exact answer, which hashes to the step's sealed ai_output_hash)",
        "records/<job_id>/traces/<step>.txt (the text the server's AI review checked, when the server returned it)",
        "records/<job_id>/job.json",
        "records/stopped-<run_id>/receipt.json",
        "records/stopped-<run_id>/steps/<step>.json (every step sealed before the stop)",
        "records/stopped-<run_id>/steps/<step>.deleted.json (a deleted step's tombstone: the run.deleted entry from the account feed, which verdifax-verify --job reads in the step's place)",
        "records/stopped-<run_id>/payloads/<step>.json (every step, the stopped one included)",
        "records/stopped-<run_id>/answers/<step>.txt",
        "records/stopped-<run_id>/traces/<step>.txt (when the server returned one)",
        "records/stopped-<run_id>/job.json"
      ]
    },
    "sign-off": {
      "flags": [
        "--note",
        "--receipt"
      ],
      "env": [],
      "writes": [
        "<folder>/signoffs.json",
        "<folder>/signoff-history.json"
      ]
    },
    "publish": {
      "flags": [
        "--receipt"
      ],
      "env": [],
      "writes": [
        "records/<job_id>/published.json",
        "records/stopped-<run_id>/published.json"
      ]
    },
    "unpublish": {
      "flags": [
        "--receipt"
      ],
      "env": [],
      "writes": [
        "records/<job_id>/published.json",
        "records/stopped-<run_id>/published.json"
      ]
    },
    "feed": {
      "flags": [],
      "env": [],
      "writes": [
        "signals.json"
      ]
    },
    "verify-commands": {
      "flags": [],
      "env": [],
      "writes": []
    }
  },
  "constants": {
    "default_model": "claude-fable-5-1",
    "form": "verdifax.claims-review.v1",
    "rule_set": "v3",
    "stop_statuses": [
      "pepg_deny",
      "aivp_t4_halt",
      "ccv_halt",
      "macc_halt",
      "attestation_gap"
    ],
    "stop_receipt_fields": [
      "deny_receipt",
      "aivp_t4_halt_receipt",
      "ccv_halt_receipt",
      "macc_halt_receipt",
      "attestation_gap_receipt"
    ],
    "actor_id": "claims-review-agent",
    "route_intake": "claims-review/v1/intake",
    "route_rule": "claims-review/v1/rule-check",
    "route_verdict": "claims-review/v1/verdict",
    "object_prefix": "claims-review/v1/",
    "min_verifier": "v0.34.0",
    "model_retry_tries": "21",
    "program_id_source": "verdifax-claims-review-demo/program/v1",
    "registry_record_hash_source": "verdifax-claims-review-demo/registry/v1",
    "decision_kinds": [
      "claims.list",
      "claims.rule_check",
      "claims.verdict"
    ],
    "verdicts": [
      "pass",
      "fail",
      "unanswered"
    ],
    "stopped_folder_prefix": "stopped-",
    "answers_folder": "answers",
    "traces_folder": "traces",
    "policy_file": "claims-review-v3.json",
    "route_claims": "claims-review/v1/claims",
    "claims_prompt": "claims-prompt-v1.txt",
    "verdict_prompt": "verdict-prompt-v1.txt",
    "deleted_step_suffix": ".deleted.json",
    "saved_head_max_age": "168h",
    "history_age_reason": "(168h: a saved history is checked as of when it was fetched; raise the limit for an older copy, or run sign-off again to fetch it fresh)",
    "feed_age_reason": "(168h: a saved feed is checked as of when it was fetched; raise the limit for an older copy, or run feed again to fetch it fresh)"
  },
  "steps": {
